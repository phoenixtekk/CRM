// =====================================================================================
// MDCAFULL-LabQueries.kql — Advanced-hunting KQL pack for the complete Microsoft Defender
//                           for Cloud Apps solution (onboarding validation + enablement labs + PoC).
//
// PURPOSE      Sample, READ-ONLY hunting queries for signal validation (Phase A), Labs 1
//              (shadow IT / discovery), 2 (connected-app activity), 3 (OAuth apps), and 5
//              (anomaly investigation), and the PoC (activity visibility). Run in the Microsoft
//              Defender portal: Hunting -> Advanced hunting. Save the marked queries under the
//              names in the Implementation Guide (03-implementation.md).
// HOW TO RUN   Paste a section into the query editor and click Run. Adjust time ranges and the
//              placeholder values (contoso names) to your tenant.
// EXPECTED     Rows from CloudAppEvents and related tables. These queries only READ telemetry;
//              they change nothing. Schema/coverage depends on your MDCA plan and connected apps —
//              verify current schema in your tenant.
// NOTE         White-label. Placeholders use contoso. No enforcement / no revocation here.
// =====================================================================================


// -------------------------------------------------------------------------------------
// SECTION 0 — SIGNAL VALIDATION  (save as: MDCA Signal Validation - Tenant - Validate)
// Confirms CloudAppEvents is streaming from the connectors / discovery (Phase A Step A7, PoC).
// -------------------------------------------------------------------------------------
CloudAppEvents
| where Timestamp > ago(24h)
| summarize Events = count(), Apps = dcount(Application), Users = dcount(AccountId),
            FirstSeen = min(Timestamp), LastSeen = max(Timestamp)
// A non-zero Events count with a recent LastSeen = signal is streaming.


// -------------------------------------------------------------------------------------
// SECTION 1 — SHADOW IT / DISCOVERY signal  (save as: Discovery-ShadowIT - CloudApps - Pilot)
// Which apps/users generate the most cloud-app activity (a proxy for adoption to review).
// -------------------------------------------------------------------------------------
CloudAppEvents
| where Timestamp > ago(7d)
| summarize Events = count(), Users = dcount(AccountId), Actions = make_set(ActionType, 15)
        by Application, ApplicationId
| sort by Events desc
| take 50


// -------------------------------------------------------------------------------------
// SECTION 2 — CONNECTED-APP ACTIVITY  (Lab 2)
// Sensitive / administrative actions inside a connected app.
// -------------------------------------------------------------------------------------
CloudAppEvents
| where Timestamp > ago(24h)
| where ActionType has_any ("Delete","Remove","Add member","Update role","Consent","Share","Download")
| project Timestamp, Application, ActionType, AccountDisplayName, IPAddress, CountryCode, ObjectName = RawEventData
| sort by Timestamp desc
| take 100


// -------------------------------------------------------------------------------------
// SECTION 3 — OAUTH APPS: consent & grant events  (save as: OAuthApps - CloudApps - Pilot)
// New/updated OAuth consent is a common, quiet data-access path — review the grantee & scopes.
// -------------------------------------------------------------------------------------
CloudAppEvents
| where Timestamp > ago(30d)
| where ActionType has_any ("Consent to application","Add app role assignment grant to user",
        "Add delegated permission grant","Add OAuth2PermissionGrant")
| project Timestamp, ActionType, AccountDisplayName, IPAddress, RawEventData
| sort by Timestamp desc


// -------------------------------------------------------------------------------------
// SECTION 4 — IMPOSSIBLE-TRAVEL-STYLE indicator (multiple countries per user, short window)
// -------------------------------------------------------------------------------------
CloudAppEvents
| where Timestamp > ago(24h)
| where isnotempty(CountryCode)
| summarize Countries = dcount(CountryCode), CountryList = make_set(CountryCode, 10),
            Events = count(), FirstSeen = min(Timestamp), LastSeen = max(Timestamp)
        by AccountDisplayName, AccountId
| where Countries >= 2
| sort by Countries desc


// -------------------------------------------------------------------------------------
// SECTION 5 — MASS-DOWNLOAD indicator  (save as: Anomaly-Investigation - CloudApps - Pilot)
// Lab 5 anomaly investigation.
// -------------------------------------------------------------------------------------
CloudAppEvents
| where Timestamp > ago(24h)
| where ActionType has "Download" or ActionType has "FileDownloaded"
| summarize Downloads = count(), Apps = make_set(Application, 10), FirstSeen = min(Timestamp), LastSeen = max(Timestamp)
        by AccountDisplayName, AccountId
| where Downloads > 50                                  // tune to your baseline
| sort by Downloads desc


// -------------------------------------------------------------------------------------
// SECTION 6 — SINGLE-USER 360 for investigation (pivot on one account)
// -------------------------------------------------------------------------------------
let Subject = "jsmith@contoso.com";
CloudAppEvents
| where Timestamp > ago(14d)
| where AccountDisplayName =~ Subject or AccountId =~ Subject
| project Timestamp, Application, ActionType, IPAddress, CountryCode, UserAgent, RawEventData
| sort by Timestamp asc
